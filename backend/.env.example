# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL standard connection string)
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Session or Transaction mode)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Custom JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=1d

# Frontend URL(s) for CORS (comma-separated if multiple, e.g., http://localhost:5173,https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# Admin Initial Seed Credentials (used by: npm run seed:admin)
ADMIN_EMAIL=admin@k12hunar.com
ADMIN_PASSWORD=Admin@Secure2026!
